// Prisma schema for SFA Amanda Group
// Multi-Business Unit Sales Force Automation Database

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SALES
  SUPERVISOR
  ASM
  NSM
  ADMIN
  FINANCE
}

enum CustomerStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

enum AttendanceStatus {
  ON_TIME
  LATE
  OUTSIDE_GEOFENCE
  NEEDS_VERIFICATION
  COMPLETED
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
  RESCHEDULED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InsightType {
  TARGET
  VISIT
  RISK
  OPPORTUNITY
  TEAM
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  OVERDUE
}

model BusinessUnit {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  description String?
  theme       BusinessUnitTheme?
  users       User[]
  customers   Customer[]
  products    Product[]
  orders      Order[]
  visits      Visit[]
  attendances Attendance[]
  insights    AgentInsight[]
  auditLogs   AuditLog[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("business_units")
}

model BusinessUnitTheme {
  id                 String       @id @default(uuid())
  businessUnitId     String       @unique @map("business_unit_id")
  businessUnit       BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  primaryColor       String       @default("#0D6E63") @map("primary_color")
  primaryDarkColor   String       @default("#094C44") @map("primary_dark_color")
  accentColor        String       @default("#C97A3A") @map("accent_color")
  accentSoftColor    String       @default("#F5E7DA") @map("accent_soft_color")
  backgroundColor    String       @default("#F1F4F3") @map("background_color")
  surfaceColor       String       @default("#FFFFFF") @map("surface_color")
  surfaceSunkenColor String       @default("#E9EEEC") @map("surface_sunken_color")
  textPrimaryColor   String       @default("#15221D") @map("text_primary_color")
  textMutedColor     String       @default("#5C6B65") @map("text_muted_color")
  textFaintColor     String       @default("#8B978F") @map("text_faint_color")
  borderColor        String       @default("#DCE4E1") @map("border_color")
  initials           String       @default("AG")
  logoUrl            String?      @map("logo_url")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("business_unit_themes")
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  passwordHash   String               @map("password_hash")
  name           String
  role           UserRole             @default(SALES)
  businessUnitId String               @map("business_unit_id")
  businessUnit   BusinessUnit         @relation(fields: [businessUnitId], references: [id])
  area           String
  initials       String
  active         Boolean              @default(true)
  orders         Order[]
  visits         Visit[]
  attendances    Attendance[]
  targets        MonthlySalesTarget[]
  insights       AgentInsight[]
  notifications  Notification[]
  followUps      FollowUp[]
  auditLogs      AuditLog[]           @relation("ActorAuditLogs")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([businessUnitId])
  @@index([role])
  @@map("users")
}

model Customer {
  id                String         @id @default(uuid())
  businessUnitId    String         @map("business_unit_id")
  businessUnit      BusinessUnit   @relation(fields: [businessUnitId], references: [id])
  name              String
  segment           String
  address           String
  pic               String
  phone             String
  latitude          Float
  longitude         Float
  area              String
  status            CustomerStatus @default(ACTIVE)
  lastVisitDaysAgo  Int            @default(0) @map("last_visit_days_ago")
  totalOrders       Int            @default(0) @map("total_orders")
  orders            Order[]
  visits            Visit[]
  followUps         FollowUp[]
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([businessUnitId])
  @@index([status])
  @@index([segment])
  @@map("customers")
}

model Product {
  id             String       @id @default(uuid())
  businessUnitId String       @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  name           String
  unit           String
  price          Decimal      @db.Decimal(12, 2)
  sku            String?      @unique
  active         Boolean      @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([businessUnitId])
  @@map("products")
}

model MonthlySalesTarget {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodLabel    String   @map("period_label")
  targetAmount   Decimal  @map("target_amount") @db.Decimal(14, 2)
  achievedAmount Decimal  @default(0) @map("achieved_amount") @db.Decimal(14, 2)
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, periodLabel])
  @@index([userId])
  @@map("monthly_sales_targets")
}

model Attendance {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnitId String           @map("business_unit_id")
  businessUnit   BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  dateKey        String           @map("date_key")
  status         AttendanceStatus @default(ON_TIME)
  checkInTime    DateTime?        @map("check_in_time")
  checkOutTime   DateTime?        @map("check_out_time")
  latitude       Float?
  longitude      Float?
  gpsAccuracy    Int?             @map("gps_accuracy")
  isLate         Boolean          @default(false) @map("is_late")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([userId, dateKey])
  @@index([userId])
  @@index([businessUnitId])
  @@map("attendances")
}

model Visit {
  id             String       @id @default(uuid())
  customerId     String       @map("customer_id")
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnitId String       @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  startTime      DateTime     @map("start_time")
  endTime        DateTime?    @map("end_time")
  purpose        String?
  outcome        String?
  notes          String?
  hasPhoto       Boolean      @default(false) @map("has_photo")
  status         VisitStatus  @default(IN_PROGRESS)
  orders         Order[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([userId])
  @@index([businessUnitId])
  @@map("visits")
}

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique @map("order_number")
  customerId       String          @map("customer_id")
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnitId   String          @map("business_unit_id")
  businessUnit     BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  visitId          String?         @map("visit_id")
  visit            Visit?          @relation(fields: [visitId], references: [id])
  subtotal         Decimal         @default(0) @db.Decimal(14, 2)
  discountPct      Decimal         @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountAmount   Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  total            Decimal         @default(0) @db.Decimal(14, 2)
  totalQty         Int             @default(0) @map("total_qty")
  requiresApproval Boolean         @default(false) @map("requires_approval")
  status           OrderStatus     @default(SUBMITTED)
  approvalReason   String?         @map("approval_reason")
  items            OrderItem[]
  approvals        OrderApproval[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([userId])
  @@index([businessUnitId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

model OrderApproval {
  id             String      @id @default(uuid())
  orderId        String      @map("order_id")
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approverUserId String?     @map("approver_user_id")
  role           String
  action         String      // APPROVED, REJECTED, PENDING
  notes          String?
  stage          String      // ASM, FINANCE, NSM
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_approvals")
}

model AgentInsight {
  id             String       @id @default(uuid())
  businessUnitId String       @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           InsightType
  text           String
  sourceData     Json?        @map("source_data")
  severity       String       @default("info")
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([businessUnitId])
  @@map("agent_insights")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model FollowUp {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String         @map("customer_id")
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime       @map("due_date")
  status     FollowUpStatus @default(PENDING)
  notes      String?
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([userId])
  @@index([customerId])
  @@map("follow_ups")
}

model AuditLog {
  id             String       @id @default(uuid())
  businessUnitId String       @map("business_unit_id")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  actorUserId    String?      @map("actor_user_id")
  actorUser      User?        @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  action         String
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([businessUnitId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
